# amoCRM API credentials
AMOCRM_SUBDOMAIN=your_subdomain
AMOCRM_ACCESS_TOKEN=your_long_lived_token
AMOCRM_PIPELINE_ID=1234567

# Telegram Target
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Порог зависания сделок (в днях без изменения статуса или задачи)
STALLED_DEAL_DAYS_THRESHOLD=5

# Режим работы (True для запуска с генерацией реалистичных данных без реальных ключей)
MOCK_MODE=True

